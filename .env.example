# ---------------------------------------------------------------------------
# Eventra AI — environment variables
# Copy this file to .env and fill in real values. Never commit .env.
# ---------------------------------------------------------------------------

# ---- Backend (server/.env) -------------------------------------------------
# Port the Express API listens on.
PORT=4000

# Node environment: development | production
NODE_ENV=development

# Google AI Studio API key. Server-side only. Never expose this to the browser
# and never prefix it with VITE_.
GEMINI_API_KEY=

# Gemini model identifier. "gemini-flash-latest" is an alias that always
# resolves to the latest flash model. Override to pin a specific model.
GEMINI_MODEL=gemini-flash-latest

# Comma-separated list of origins allowed to call the API (CORS).
# In production set this to your deployed frontend origin(s).
CLIENT_ORIGIN=http://localhost:5173

# Milliseconds to wait for a Gemini response before failing the request.
AI_REQUEST_TIMEOUT_MS=30000

# Rate limiting for expensive AI endpoints.
AI_RATE_LIMIT_WINDOW_MS=60000
AI_RATE_LIMIT_MAX=30

# Maximum accepted request body size.
BODY_LIMIT=1mb

# Optional: serve the built frontend from the same Node process.
# Leave empty/disabled for separate frontend hosting (recommended).
SERVE_STATIC=

# ---- Frontend (client/.env) ------------------------------------------------
# Base URL of the backend API. Must NOT contain a trailing slash.
VITE_API_BASE_URL=http://localhost:4000
